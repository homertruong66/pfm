{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BE: Django (manage.py runserver)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver", "8000"],
      "django": true,
      "justMyCode": false,
      "subProcess": true,
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "FE: Chrome against localhost:3000/login",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000/login",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${webRoot}/*",
        "turbopack://[project]/*": "${webRoot}/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug FE + BE together",
      "configurations": ["BE: Django (manage.py runserver)", "FE: Chrome against localhost:3000/login"]
    }
  ]
}
